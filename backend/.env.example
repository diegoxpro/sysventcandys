# Conexión a PostgreSQL en la PC de la tienda
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/candys?schema=public"
# Cambia este valor por una frase larga y secreta
JWT_SECRET="cambia-esta-clave"
PORT=3000
# Celulares del inventario: IP de esta PC en el WiFi (va en el QR) y puertos.
# HTTPS_PORT=0 desactiva el acceso desde la red.
RED_IP=192.168.18.90
HTTPS_PORT=3443
RED_HTTP_PORT=3080
