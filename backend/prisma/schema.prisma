// Base de datos del sistema de ventas Candy's Market.
// Fase 1: usuarios, configuración, productos, proveedores, compras,
// cuentas por pagar, lotes/vencimientos, mermas y movimientos de stock.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CAJERO
}

enum AfectacionIgv {
  GRAVADO
  EXONERADO
  INAFECTO
}

enum TipoMovimiento {
  IMPORTACION
  COMPRA
  ANULACION_COMPRA
  VENTA
  ANULACION_VENTA
  MERMA
  AJUSTE
}

enum TipoDocumentoCompra {
  FACTURA
  BOLETA
  GUIA
  NOTA_VENTA
}

enum CondicionPago {
  CONTADO
  CREDITO
}

enum EstadoCompra {
  REGISTRADA
  ANULADA
}

enum MedioPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  nombre       String
  passwordHash String
  rol          Rol      @default(CAJERO)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimientos       MovimientoStock[]
  compras           Compra[]
  pagos             PagoProveedor[]
  ventas            Venta[]           @relation("VentaUsuario")
  ventasAnuladas    Venta[]           @relation("VentaAnulador")
  ventasAutorizadas Venta[]           @relation("VentaAutorizador")
  cajasAbiertas     Caja[]            @relation("CajaApertura")
  cajasCerradas     Caja[]            @relation("CajaCierre")
  movimientosCaja   MovimientoCaja[]
}

// Fila única (id = 1) con los datos de la tienda y las preferencias.
model Configuracion {
  id                    Int       @id @default(1)
  empresaNombre         String    @default("CANDY'S MARKET")
  empresaRuc            String?
  empresaDireccion      String?
  permitirVentaSinStock Boolean   @default(false)
  // Margen de ganancia por defecto (%) sobre el costo para cada precio.
  margen1               Decimal   @default(25) @db.Decimal(6, 2)
  margen2               Decimal   @default(20) @db.Decimal(6, 2)
  margen3               Decimal   @default(15) @db.Decimal(6, 2)
  // Los precios sugeridos se redondean hacia arriba a este múltiplo (S/ 0.10).
  redondeoPrecio        Decimal   @default(0.10) @db.Decimal(6, 2)
  diasAvisoVencimiento  Int       @default(15)
  montoInicialCaja      Decimal   @default(150) @db.Decimal(12, 2)
  mensajeTicket         String?   @default("¡Gracias por su compra!")
  // Carpeta sincronizada con Google Drive (Google Drive para escritorio).
  backupCarpeta         String?
  backupHora            String    @default("22:00")
  backupConservar       Int       @default(30)
  // Ruta de pg_dump; vacío = buscarlo en el PATH.
  pgDumpRuta            String?
  // Datos del emisor para la facturación electrónica.
  empresaRazonSocial    String?
  empresaUbigeo         String?
  empresaDepartamento   String?
  empresaProvincia      String?
  empresaDistrito       String?
  codigoEstablecimiento String    @default("0000")
  sunatModo             ModoSunat @default(DESACTIVADO)
  updatedAt             DateTime  @updatedAt
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id                  Int           @id @default(autoincrement())
  codigoBarra         String?       @unique
  // Id del producto en SysVent, para trazar la importación.
  codigoAnterior      String?       @unique
  nombre              String
  categoriaId         Int?
  marcaId             Int?
  unidad              String        @default("UND")
  costo               Decimal       @default(0) @db.Decimal(12, 4)
  precio1             Decimal       @default(0) @db.Decimal(12, 2)
  precio2             Decimal       @default(0) @db.Decimal(12, 2)
  precio3             Decimal       @default(0) @db.Decimal(12, 2)
  // Si es null se usa el margen de la configuración.
  margen1             Decimal?      @db.Decimal(6, 2)
  margen2             Decimal?      @db.Decimal(6, 2)
  margen3             Decimal?      @db.Decimal(6, 2)
  stock               Decimal       @default(0) @db.Decimal(12, 3)
  stockMinimo         Decimal       @default(0) @db.Decimal(12, 3)
  afectacionIgv       AfectacionIgv @default(EXONERADO)
  controlaVencimiento Boolean       @default(false)
  activo              Boolean       @default(true)
  // Marcado al importar cuando el dato necesita revisión (motivo).
  revisar             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  categoria   Categoria?        @relation(fields: [categoriaId], references: [id])
  marca       Marca?            @relation(fields: [marcaId], references: [id])
  lotes       Lote[]
  movimientos MovimientoStock[]
  compraItems CompraItem[]
  ventaItems  VentaItem[]

  @@index([nombre])
}

model Lote {
  id               Int      @id @default(autoincrement())
  productoId       Int
  codigo           String?
  fechaVencimiento DateTime @db.Date
  cantidad         Decimal  @db.Decimal(12, 3)
  compraItemId     Int?     @unique
  createdAt        DateTime @default(now())

  producto    Producto          @relation(fields: [productoId], references: [id])
  compraItem  CompraItem?       @relation(fields: [compraItemId], references: [id])
  movimientos MovimientoStock[]

  @@index([fechaVencimiento])
}

// Cada entrada o salida de stock. Es la base del kardex.
model MovimientoStock {
  id              Int            @id @default(autoincrement())
  productoId      Int
  loteId          Int?
  usuarioId       Int?
  ventaId         Int?
  tipo            TipoMovimiento
  // Positivo entra, negativo sale.
  cantidad        Decimal        @db.Decimal(12, 3)
  stockResultante Decimal        @db.Decimal(12, 3)
  costoUnitario   Decimal        @default(0) @db.Decimal(12, 4)
  referencia      String?
  motivo          String?
  fecha           DateTime       @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  lote     Lote?    @relation(fields: [loteId], references: [id])
  usuario  Usuario? @relation(fields: [usuarioId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])

  @@index([productoId, fecha])
  @@index([ventaId])
  @@index([tipo, fecha])
}

model Proveedor {
  id              Int      @id @default(autoincrement())
  ruc             String?  @unique
  razonSocial     String
  nombreComercial String?
  telefono        String?
  email           String?
  direccion       String?
  contacto        String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  compras Compra[]
}

model Compra {
  id               Int                 @id @default(autoincrement())
  proveedorId      Int
  usuarioId        Int
  tipoDocumento    TipoDocumentoCompra @default(FACTURA)
  serie            String
  numero           String
  fechaEmision     DateTime            @db.Date
  condicion        CondicionPago       @default(CONTADO)
  fechaVencimiento DateTime?           @db.Date
  total            Decimal             @db.Decimal(12, 2)
  saldo            Decimal             @db.Decimal(12, 2)
  estado           EstadoCompra        @default(REGISTRADA)
  observacion      String?
  createdAt        DateTime            @default(now())

  proveedor Proveedor       @relation(fields: [proveedorId], references: [id])
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  items     CompraItem[]
  pagos     PagoProveedor[]

  @@unique([proveedorId, tipoDocumento, serie, numero])
  @@index([fechaEmision])
}

model CompraItem {
  id               Int       @id @default(autoincrement())
  compraId         Int
  productoId       Int
  cantidad         Decimal   @db.Decimal(12, 3)
  costoUnitario    Decimal   @db.Decimal(12, 4)
  subtotal         Decimal   @db.Decimal(12, 2)
  codigoLote       String?
  fechaVencimiento DateTime? @db.Date

  compra   Compra   @relation(fields: [compraId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
  lote     Lote?
}

model PagoProveedor {
  id              Int       @id @default(autoincrement())
  compraId        Int
  usuarioId       Int
  fecha           DateTime  @default(now())
  monto           Decimal   @db.Decimal(12, 2)
  medioPago       MedioPago @default(EFECTIVO)
  numeroOperacion String?
  observacion     String?

  compra         Compra          @relation(fields: [compraId], references: [id])
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  movimientoCaja MovimientoCaja?
}

// ---------------------------------------------------------------- Ventas y caja

enum ModoSunat {
  DESACTIVADO
  BETA
  PRODUCCION
}

enum EstadoSunat {
  // Boleta libre o facturación electrónica desactivada.
  NO_APLICA
  PENDIENTE
  ACEPTADO
  OBSERVADO
  RECHAZADO
  // Boleta aceptada y luego anulada: se informa en un resumen diario.
  BAJA_PENDIENTE
  BAJA_ENVIADA
  BAJA_ACEPTADA
}

enum EstadoResumen {
  ENVIADO
  ACEPTADO
  RECHAZADO
}

enum TipoComprobante {
  BOLETA
  // Documento interno que no va a SUNAT ("boleta de venta libre").
  BOLETA_LIBRE
}

enum EstadoVenta {
  EMITIDA
  ANULADA
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum TipoDocIdentidad {
  DNI
  RUC
  CE
  SIN_DOCUMENTO
}

model Serie {
  id           Int             @id @default(autoincrement())
  tipo         TipoComprobante
  serie        String          @unique
  // Último número emitido; la próxima venta usa ultimoNumero + 1.
  ultimoNumero Int             @default(0)
  activa       Boolean         @default(true)
  ventas       Venta[]
}

model Cliente {
  id        Int              @id @default(autoincrement())
  tipoDoc   TipoDocIdentidad @default(DNI)
  numeroDoc String?          @unique
  nombre    String
  direccion String?
  telefono  String?
  createdAt DateTime         @default(now())
  ventas    Venta[]
}

model Caja {
  id                Int        @id @default(autoincrement())
  estado            EstadoCaja @default(ABIERTA)
  usuarioAperturaId Int
  fechaApertura     DateTime   @default(now())
  montoInicial      Decimal    @db.Decimal(12, 2)
  usuarioCierreId   Int?
  fechaCierre       DateTime?
  // Resumen congelado al cerrar: esperado por medio, conteo de billetes, etc.
  resumenCierre     Json?
  efectivoEsperado  Decimal?   @db.Decimal(12, 2)
  efectivoContado   Decimal?   @db.Decimal(12, 2)
  diferencia        Decimal?   @db.Decimal(12, 2)
  observacion       String?

  usuarioApertura Usuario          @relation("CajaApertura", fields: [usuarioAperturaId], references: [id])
  usuarioCierre   Usuario?         @relation("CajaCierre", fields: [usuarioCierreId], references: [id])
  ventas          Venta[]
  movimientos     MovimientoCaja[]

  @@index([estado])
}

model MovimientoCaja {
  id              Int                @id @default(autoincrement())
  cajaId          Int
  usuarioId       Int
  tipo            TipoMovimientoCaja
  concepto        String
  monto           Decimal            @db.Decimal(12, 2)
  fecha           DateTime           @default(now())
  // Si el egreso pagó una factura de proveedor.
  pagoProveedorId Int?               @unique

  caja          Caja           @relation(fields: [cajaId], references: [id])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  pagoProveedor PagoProveedor? @relation(fields: [pagoProveedorId], references: [id])
}

model Venta {
  id               Int             @id @default(autoincrement())
  cajaId           Int
  usuarioId        Int
  serieId          Int
  tipoComprobante  TipoComprobante
  serie            String
  numero           Int
  fecha            DateTime        @default(now())
  clienteId        Int?
  nivelPrecio      Int             @default(1)
  // Suma de los ítems antes del descuento global.
  subtotal         Decimal         @db.Decimal(12, 2)
  descuento        Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  opExonerada      Decimal         @default(0) @db.Decimal(12, 2)
  opGravada        Decimal         @default(0) @db.Decimal(12, 2)
  opInafecta       Decimal         @default(0) @db.Decimal(12, 2)
  igv              Decimal         @default(0) @db.Decimal(12, 2)
  costoTotal       Decimal         @default(0) @db.Decimal(12, 2)
  efectivoRecibido Decimal?        @db.Decimal(12, 2)
  vuelto           Decimal         @default(0) @db.Decimal(12, 2)
  estado           EstadoVenta     @default(EMITIDA)
  // Administrador que autorizó descuentos.
  autorizadoPorId  Int?
  anuladaPorId     Int?
  fechaAnulacion   DateTime?
  motivoAnulacion  String?
  // Facturación electrónica
  estadoSunat      EstadoSunat     @default(NO_APLICA)
  hashCpe          String?
  xmlFirmado       String?
  cdrCodigo        String?
  cdrMensaje       String?
  sunatEnviadoEn   DateTime?
  sunatIntentos    Int             @default(0)
  sunatError       String?
  resumenBajaId    Int?

  caja          Caja              @relation(fields: [cajaId], references: [id])
  usuario       Usuario           @relation("VentaUsuario", fields: [usuarioId], references: [id])
  serieRef      Serie             @relation(fields: [serieId], references: [id])
  cliente       Cliente?          @relation(fields: [clienteId], references: [id])
  autorizadoPor Usuario?          @relation("VentaAutorizador", fields: [autorizadoPorId], references: [id])
  anuladaPor    Usuario?          @relation("VentaAnulador", fields: [anuladaPorId], references: [id])
  items         VentaItem[]
  pagos         VentaPago[]
  movimientos   MovimientoStock[]
  resumenBaja   ResumenDiario?    @relation(fields: [resumenBajaId], references: [id])

  @@unique([serie, numero])
  @@index([estadoSunat])
  @@index([fecha])
  @@index([cajaId])
}

model VentaItem {
  id             Int           @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  descripcion    String
  cantidad       Decimal       @db.Decimal(12, 3)
  precioUnitario Decimal       @db.Decimal(12, 2)
  descuento      Decimal       @default(0) @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  costoUnitario  Decimal       @default(0) @db.Decimal(12, 4)
  afectacionIgv  AfectacionIgv

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
}

model VentaPago {
  id              Int       @id @default(autoincrement())
  ventaId         Int
  medioPago       MedioPago
  // Lo que se aplica a la venta (el efectivo ya descuenta el vuelto).
  monto           Decimal   @db.Decimal(12, 2)
  numeroOperacion String?

  venta Venta @relation(fields: [ventaId], references: [id])
}

model Backup {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  archivo String?
  tamano  Int?
  ok      Boolean
  origen  String
  error   String?
}

// Resumen diario enviado a SUNAT para dar de baja boletas.
model ResumenDiario {
  id              Int           @id @default(autoincrement())
  identificador   String        @unique
  fechaReferencia DateTime      @db.Date
  fechaGeneracion DateTime      @default(now())
  ticket          String?
  estado          EstadoResumen @default(ENVIADO)
  cdrCodigo       String?
  mensaje         String?
  xmlFirmado      String?
  ventas          Venta[]
}
